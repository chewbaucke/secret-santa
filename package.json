{
  "name": "secret-santa",
  "version": "1.0.0",
  "description": "Secret Santa gift exchange web app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0 && eslint '__tests__/**/*.{ts,tsx}' --max-warnings 0",
